# Copy to .env. Private values must never be committed.
# Restart recipe (repository root): python3 Michael/bootstrap/provision.py --init-env, then the docker compose command
# below with --build, then python3 Michael/bootstrap/provision.py. --init-env only ADDS missing non-secret or generated
# keys here (MAIL_SERVICE_SRC, EMPLOYEE_DIRECTORY_SRC, QDTS_CASES_SRC, QDTS_MCP_API_KEY, QDTS_CUSTOMER_NAMES,
# MAIL_PROVIDER, MAIL_SMTP_TLS_VERIFY, MAIL_MCP_API_KEY, WEBUI_SECRET_KEY); it never
# overwrites or prints a value. compose loads this whole file into the Open WebUI container, so keep it private (mode 600).
# Compose: docker compose --env-file Michael/.env -f Michael/docker-compose.yaml up -d
# OpenAI-compatible model provider (use the /v1 base URL). Separate several
# connections with ";" and keep the two lists in the same order.
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=
# xAI (Grok) direct connection, added by bootstrap/xai_connection.py beside the
# connection above. xAI is an OUTSIDE service: send only synthetic or approved
# data. Leave XAI_API_KEY empty to skip it. Its public certificate cannot be
# verified with the Davy bundle alone, so use the combined bundle below.
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
# In-container path of the CA bundle that docker-compose.yaml mounts read-only
# from Michael/runtime/certs/. Open WebUI trusts ONLY this file. Place the
# approved private certificates (e.g. davy-ca-bundle.pem) in that folder, then
# run bootstrap/build_ca_bundle.py to combine them with the system CAs into
# ca-bundle.pem. Never disable TLS verification.
AIOHTTP_CLIENT_SSL_CERT_FILE=/certs/ca-bundle.pem
OPEN_WEBUI_PORT=3000
# bootstrap/davy_connection.py: where the running Open WebUI is reachable from
# the host (defaults to http://localhost:$OPEN_WEBUI_PORT), and admin credentials
# for its admin API. Supply EITHER an admin API key (needs ENABLE_API_KEYS=true
# and a key created in Settings > Account) OR the admin email and password.
# These are also loaded into the container by compose; to avoid that, export
# them in your shell instead of writing them here.
OPEN_WEBUI_URL=
OPEN_WEBUI_ADMIN_API_KEY=
OPEN_WEBUI_ADMIN_EMAIL=
OPEN_WEBUI_ADMIN_PASSWORD=
# provision.py creates this account as the first admin on a fresh volume. Sign-up is closed (below): every other
# account is created by an admin (docs/accounts.md).
# Leave WEBUI_SECRET_KEY empty: provision.py --init-env generates a random one (never overwritten). Without a stable key
# every container restart makes a new one, which signs everyone out and makes saved tool keys unreadable. Changing it
# later does the same: browsers then need a one-time sign-out (docs/deployment.md, Session key).
WEBUI_SECRET_KEY=
# Encrypt tool valves (the translator API key) at rest. docker-compose.yaml
# defaults this to true. It encrypts with a key derived from WEBUI_SECRET_KEY, so
# keep that value stable: after rotating it, saved valve values cannot be read and
# must be re-entered (re-run bootstrap/translator_tool.py).
ENABLE_VALVE_ENCRYPTION=true
# Self sign-up is closed and new accounts default to the user role. The first account on a fresh volume is still
# allowed (Open WebUI makes it the admin). Saved settings override these, so bootstrap/accounts.py also saves them.
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=user
# Optional image tags (defaults in docker-compose.yaml).
OPEN_WEBUI_IMAGE=
# The scoped backend build requires a retained compatible base image; see docs/deployment.md, Backend overlay.
# Leave empty on the existing deployment, or deliberately select a reviewed base on another host.
OPEN_WEBUI_BACKEND_BASE=
# Leave empty to use the version + digest pinned in docker-compose.yaml.
OPEN_TERMINAL_IMAGE=
# Generated once by bootstrap/init_env.py; never commit the real key.
OPEN_TERMINAL_API_KEY=
# Translator. TRANSLATOR_GATEWAY_URL is the gateway MCP URL (Streamable HTTP, the
# /mcp URL) as reachable FROM THE OPEN WEBUI CONTAINER, e.g.
# http://host.docker.internal:8766/mcp (compose maps host.docker.internal to the
# host; the gateway must listen on an interface the container can reach).
# TRANSLATOR_API_KEY is one shared key for all Open WebUI users. Both are used by
# bootstrap/mcp_servers.py (the MCP connection) and, with the base model below
# (a model id as listed by Open WebUI) and the optional TRANSLATOR_ID engine
# (empty = the gateway default), by bootstrap/translator_tool.py (tool valves and
# preset). The key is stored in the tool valves and the MCP connection, and
# compose loads this file into the container, so keep it private.
TRANSLATOR_GATEWAY_URL=
TRANSLATOR_API_KEY=
TRANSLATOR_BASE_MODEL=
# Base model of every preset and of the translator tool (bootstrap/presets.py, translator_tool.py). Empty = the
# committed default, Laguna S 2.1 (laguna-s-2.1, on the Davy connection).
# CASE SAFETY: provisioning refuses an XAI key or any base other than the approved model (laguna-s-2.1) while the plain-name QDTS
# integration is installed. Keep all case/PATH presets on the approved internal connection.
# The provisioning guard is NOT a runtime authorization boundary. Remove the case integration
# under an approved change before using outside providers.
PRESETS_BASE_MODEL=
# Web search for the presets that use it (Lenny, Web Searcher): Perplexity. compose passes
# ENABLE_WEB_SEARCH=true, WEB_SEARCH_ENGINE=perplexity_search and this key to Open WebUI, and
# bootstrap/presets.py pushes the same settings to an existing volume. No SearXNG needed.
PERPLEXITY_API_KEY=
TRANSLATOR_ID=
# Employee directory service (docker-compose.yaml, service employee-directory).
# Build context: a checkout of the employee-directory repository. Put the real
# path in your private .env (default: ./services/employee-directory).
EMPLOYEE_DIRECTORY_SRC=/path/to/employee-directory
# Host port for the directory UI. Published on 127.0.0.1 ONLY: the UI and REST API
# have no sign-in.
EMPLOYEE_DIRECTORY_PORT=8780
# MCP write tools to expose on the main instance (create,update,delete or all).
# Empty = read-only, which is what mcp/mcp.json registers.
EMPLOYEE_MCP_WRITE_TOOLS=
# Enables permanent delete and import in the directory; empty disables them.
EMPLOYEE_ADMIN_TOKEN=
# Optional bearer key for the directory's /mcp endpoint. When set, the
# directory requires it and bootstrap/mcp_servers.py sends it.
EMPLOYEE_MCP_API_KEY=
# bootstrap/mcp_servers.py: only when the URL differs from the service-name
# default http://employee-directory:8000/mcp.
EMPLOYEE_DIRECTORY_MCP_URL=
# Optional write instance (docker compose --profile write ...): its own bearer
# key (required to start it) and the tools it exposes. The matching
# employee_directory_write entry in mcp/mcp.json is disabled until you enable it.
EMPLOYEE_WRITE_MCP_API_KEY=
EMPLOYEE_WRITE_MCP_TOOLS=create,update,delete
EMPLOYEE_WRITE_MCP_URL=
# Mail service (docker-compose.yaml, service mail-service). Build context: a checkout of the
# mail-service repository. MAIL_MCP_API_KEY is the shared key of the model's draft-only MCP channel
# (generate a long random value; it is also sent by bootstrap/mcp_servers.py). MAIL_PROVIDER is mock
# (records messages in the data volume, sends nothing; the default) or smtp, which uses the SMTP_*
# values below. The sender is the user's company address, otherwise MAIL_SHARED_SENDER.
MAIL_SERVICE_SRC=/path/to/mail-service
MAIL_MCP_API_KEY=
MAIL_PROVIDER=mock
# true lets a model send the owner's own draft with the send_draft tool (for automations, or when the user says
# "send it"); false keeps the model channel draft-only so only the review form's Send click sends.
MAIL_MCP_ALLOW_SEND=false
# init-env sets smtp when SMTP_HOST is set (your relay), otherwise mock. mock records messages in the data volume and sends nothing.
MAIL_SHARED_SENDER=lenny@lenovo.com
MAIL_ALLOWED_DOMAINS=lenovo.com
SMTP_HOST=
SMTP_PORT=
SMTP_USE_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional in-container CA bundle for the relay, e.g. /certs/ca-bundle.pem (alternative to the next line).
MAIL_SMTP_CA_FILE=
# false keeps STARTTLS but does NOT verify the relay's certificate or host name. Use only for a relay whose certificate
# cannot be verified (internal authority, no DNS name in it). RISK: anyone who can intercept the connection to the relay
# can pose as it and read the SMTP credentials and every message. init-env sets false when the provider is smtp;
# prefer MAIL_SMTP_CA_FILE and remove the line once you can verify. bootstrap/smtp_check.py tests the relay without sending.
MAIL_SMTP_TLS_VERIFY=true
# bootstrap/mcp_servers.py: only when the URL differs from http://mail-service:8000/mcp.
MAIL_MCP_URL=

# PATH nine-tool read-only MCP; registration defaults to this local review endpoint.
# Override with an approved internal /mcp/ URL reachable from the Open WebUI container.
PATH_MCP_URL=http://host.docker.internal:18076/mcp/
# Keyless internal network by default; set only if the backend requires a shared bearer key.
PATH_MCP_API_KEY=

# QDTS read-only cases. Source checkout is used for building the separate cases image ONLY.
# Pin/review the devqdts revision before rollout. No source data is baked into the image.
QDTS_CASES_SRC=/path/to/devqdts
QDTS_CASES_IMAGE=michael-qdts-cases:local
# Generated by --init-env. Shared bearer key; no user identity/header and no per-user authorization.
QDTS_MCP_API_KEY=
# MCP URL FROM Open WebUI. Empty uses http://qdts-cases:8000/mcp/v2 (no host port published).
# V2 service plus schema-3 index must be ready before MCP/preset provisioning.
QDTS_MCP_V2_URL=
# The current service is plain-only: alias is NOT implemented; no QDTS_ALIAS_KEY is needed.
# Guard refuses plain if XAI_API_KEY is set, the effective preset base is not laguna-s-2.1,
# multiple provider URLs exist, or saved connections differ from the single approved Davy endpoint.
QDTS_CUSTOMER_NAMES=plain
# Operator-approved folder containing normalized devqdts.db and any matching WAL/SHM sidecars.
# Only the one-shot indexer sees it, read-only. NEVER auto-discovered by --init-env.
# Obtain a consistent backup after approved sync; do not copy an active DB's sidecars separately.
QDTS_DEVQDTS_DATA=/path/to/approved-normalized-data
# For isolated validation also override COMPOSE_PROJECT_NAME, OPEN_WEBUI_PORT, OPEN_WEBUI_VOLUME and
# EMPLOYEE_DIRECTORY_PORT. OPEN_WEBUI_VOLUME must be a newly created throwaway volume, never the live one.
