# Copy to .env. Private values must never be committed.
# Compose: docker compose --env-file Michael/.env -f Michael/docker-compose.yaml up -d
# OpenAI-compatible model provider (use the /v1 base URL). Separate several
# connections with ";" and keep the two lists in the same order.
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=
# xAI (Grok) direct connection, added by bootstrap/xai_connection.py beside the
# connection above. xAI is an OUTSIDE service: send only synthetic or approved
# data. Leave XAI_API_KEY empty to skip it. Its public certificate cannot be
# verified with the Davy bundle alone, so use the combined bundle below.
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
# In-container path of the CA bundle that docker-compose.yaml mounts read-only
# from Michael/runtime/certs/. Open WebUI trusts ONLY this file. Place the
# approved private certificates (e.g. davy-ca-bundle.pem) in that folder, then
# run bootstrap/build_ca_bundle.py to combine them with the system CAs into
# ca-bundle.pem. Never disable TLS verification.
AIOHTTP_CLIENT_SSL_CERT_FILE=/certs/ca-bundle.pem
OPEN_WEBUI_PORT=3000
# bootstrap/davy_connection.py: where the running Open WebUI is reachable from
# the host (defaults to http://localhost:$OPEN_WEBUI_PORT), and admin credentials
# for its admin API. Supply EITHER an admin API key (needs ENABLE_API_KEYS=true
# and a key created in Settings > Account) OR the admin email and password.
# These are also loaded into the container by compose; to avoid that, export
# them in your shell instead of writing them here.
OPEN_WEBUI_URL=
OPEN_WEBUI_ADMIN_API_KEY=
OPEN_WEBUI_ADMIN_EMAIL=
OPEN_WEBUI_ADMIN_PASSWORD=
WEBUI_SECRET_KEY=
# Encrypt tool valves (the translator API key) at rest. docker-compose.yaml
# defaults this to true. It encrypts with a key derived from WEBUI_SECRET_KEY, so
# keep that value stable: after rotating it, saved valve values cannot be read and
# must be re-entered (re-run bootstrap/translator_tool.py).
ENABLE_VALVE_ENCRYPTION=true
# Optional image tags (defaults in docker-compose.yaml).
OPEN_WEBUI_IMAGE=
SEARXNG_IMAGE=
OPEN_TERMINAL_IMAGE=
# Translator. TRANSLATOR_GATEWAY_URL is the gateway MCP URL (Streamable HTTP, the
# /mcp URL) as reachable FROM THE OPEN WEBUI CONTAINER, e.g.
# http://host.docker.internal:8766/mcp (compose maps host.docker.internal to the
# host; the gateway must listen on an interface the container can reach).
# TRANSLATOR_API_KEY is one shared key for all Open WebUI users. Both are used by
# bootstrap/mcp_servers.py (the MCP connection) and, with the base model below
# (a model id as listed by Open WebUI) and the optional TRANSLATOR_ID engine
# (empty = the gateway default), by bootstrap/translator_tool.py (tool valves and
# preset). The key is stored in the tool valves and the MCP connection, and
# compose loads this file into the container, so keep it private.
TRANSLATOR_GATEWAY_URL=
TRANSLATOR_API_KEY=
TRANSLATOR_BASE_MODEL=
TRANSLATOR_ID=
# Employee directory service (docker-compose.yaml, service employee-directory).
# Build context: a checkout of the employee-directory repository. Put the real
# path in your private .env (default: ./services/employee-directory).
EMPLOYEE_DIRECTORY_SRC=/path/to/employee-directory
# Host port for the directory UI. Published on 127.0.0.1 ONLY: the UI and REST API
# have no sign-in.
EMPLOYEE_DIRECTORY_PORT=8780
# MCP write tools to expose on the main instance (create,update,delete or all).
# Empty = read-only, which is what mcp/mcp.json registers.
EMPLOYEE_MCP_WRITE_TOOLS=
# Enables permanent delete and import in the directory; empty disables them.
EMPLOYEE_ADMIN_TOKEN=
# Optional bearer key for the directory's /mcp endpoint. When set, the
# directory requires it and bootstrap/mcp_servers.py sends it.
EMPLOYEE_MCP_API_KEY=
# bootstrap/mcp_servers.py: only when the URL differs from the service-name
# default http://employee-directory:8000/mcp.
EMPLOYEE_DIRECTORY_MCP_URL=
# Optional write instance (docker compose --profile write ...): its own bearer
# key (required to start it) and the tools it exposes. The matching
# employee_directory_write entry in mcp/mcp.json is disabled until you enable it.
EMPLOYEE_WRITE_MCP_API_KEY=
EMPLOYEE_WRITE_MCP_TOOLS=create,update,delete
EMPLOYEE_WRITE_MCP_URL=
