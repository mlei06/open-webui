{
  "schemaVersion": 1,
  "base_model": "gemma-4-31b-it",
  "filter_ids": ["user_context"],
  "knowledge_bases": ["sops"],
  "actions": [
    {
      "id": "mail_review",
      "name": "Review and send email",
      "description": "Button under an assistant message: opens the chat's unsent mail draft in an editable form with its attachments. Only the user's Send click sends.",
      "file": "mail_review.py"
    }
  ],
  "presets": [
    {
      "id": "lenny",
      "name": "Lenny",
      "description": "All-in-one assistant: web search, document translation, employee directory and mail drafting.",
      "prompt": "lenny.md",
      "tools": [
        {"server": "doctranslator"},
        {"tool": "document_translator"},
        {"server": "employee_directory"},
        {"server": "mail"}
      ],
      "actions": ["mail_review"],
      "capabilities": {
        "file_upload": true,
        "file_context": false,
        "web_search": true,
        "image_generation": false,
        "code_interpreter": false,
        "terminal": false,
        "memory": false,
        "builtin_tools": true,
        "citations": true,
        "status_updates": true,
        "usage": false
      },
      "builtin_tools": ["time", "user_input", "web_search", "files", "knowledge"],
      "default_features": ["web_search"],
      "params": {}
    },
    {
      "id": "document-translator",
      "name": "Document Translator",
      "description": "Translates attached documents and returns the translated file. Nothing else.",
      "prompt": "document-translator.md",
      "tools": [
        {"server": "doctranslator"},
        {"tool": "document_translator"}
      ],
      "capabilities": {
        "file_upload": true,
        "file_context": false,
        "web_search": false,
        "image_generation": false,
        "code_interpreter": false,
        "terminal": false,
        "memory": false,
        "builtin_tools": true,
        "citations": true,
        "status_updates": true,
        "usage": false
      },
      "builtin_tools": [],
      "default_features": [],
      "params": {"temperature": 0.2}
    },
    {
      "id": "web-searcher",
      "name": "Web Searcher",
      "description": "Searches the web and answers with cited sources. No other tools.",
      "prompt": "web-searcher.md",
      "tools": [],
      "capabilities": {
        "file_upload": false,
        "file_context": false,
        "web_search": true,
        "image_generation": false,
        "code_interpreter": false,
        "terminal": false,
        "memory": false,
        "builtin_tools": true,
        "citations": true,
        "status_updates": true,
        "usage": false
      },
      "builtin_tools": ["time", "web_search"],
      "default_features": ["web_search"],
      "params": {"temperature": 0.3}
    },
    {
      "id": "office-agent",
      "name": "Office Agent",
      "description": "Finds colleagues in the employee directory and drafts email for you to review and send.",
      "prompt": "office-agent.md",
      "tools": [
        {"server": "employee_directory"},
        {"server": "mail"}
      ],
      "actions": ["mail_review"],
      "capabilities": {
        "file_upload": true,
        "file_context": false,
        "web_search": false,
        "image_generation": false,
        "code_interpreter": false,
        "terminal": false,
        "memory": false,
        "builtin_tools": true,
        "citations": true,
        "status_updates": true,
        "usage": false
      },
      "builtin_tools": ["time", "user_input"],
      "default_features": [],
      "params": {"temperature": 0.3}
    },
    {
      "id": "knowledge-base-manager",
      "name": "Knowledge Base Manager",
      "description": "Creates, updates and organises your knowledge bases from files you attach (for example a new SOP). Asks before deleting or overwriting.",
      "prompt": "knowledge-base-manager.md",
      "tools": [
        {"tool": "knowledge_base_manager"}
      ],
      "capabilities": {
        "file_upload": true,
        "file_context": false,
        "web_search": false,
        "image_generation": false,
        "code_interpreter": false,
        "terminal": false,
        "memory": false,
        "builtin_tools": true,
        "citations": true,
        "status_updates": true,
        "usage": false
      },
      "builtin_tools": ["time", "user_input", "files"],
      "default_features": [],
      "params": {"temperature": 0.2}
    }
  ]
}
